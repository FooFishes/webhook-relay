#!/usr/bin/env bash
# 服务器端发布工具，以 root 运行（sudo）。由 scripts/deploy.sh 同步到部署目录。
#
#   relayctl deploy <tag>   备份数据 → 切换到 webhook-relay:<tag> → 等待健康；失败自动恢复
#   relayctl rollback       回到上一次发布前的镜像和数据（会先备份当前数据）
#   relayctl status         当前版本、健康状态、可用镜像与备份
#   relayctl logs [n]       最近 n 行日志（默认 200）
set -euo pipefail

APP_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
IMAGE=webhook-relay
CONTAINER=webhook-relay
VOLUME=webhook-relay_relay-data
KEEP_IMAGES="${KEEP_IMAGES:-5}"
KEEP_BACKUPS="${KEEP_BACKUPS:-10}"
WAIT_TIMEOUT="${WAIT_TIMEOUT:-90}"

cd "$APP_DIR"
compose() { docker compose --project-directory "$APP_DIR" -f "$APP_DIR/compose.yaml" "$@"; }
log() { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
die() { printf '\033[1;31merror:\033[0m %s\n' "$*" >&2; exit 1; }

[[ $EUID -eq 0 ]] || die "需要 root 权限，请用 sudo 运行"
[[ -f .env ]] || die "$APP_DIR/.env 不存在"

exec 9>"$APP_DIR/.relayctl.lock"
flock -n 9 || die "另一个 relayctl 正在运行"

current_tag() {
  docker inspect "$CONTAINER" --format '{{.Config.Image}}' 2>/dev/null | sed "s/^$IMAGE://" || true
}

set_tag() {
  if grep -q '^RELAY_IMAGE_TAG=' .env; then
    sed -i "s/^RELAY_IMAGE_TAG=.*/RELAY_IMAGE_TAG=$1/" .env
  else
    printf 'RELAY_IMAGE_TAG=%s\n' "$1" >>.env
  fi
}

volume_path() { docker volume inspect "$VOLUME" --format '{{.Mountpoint}}' 2>/dev/null || true; }

# 停止容器后整体复制数据卷（含 SQLite 的 -wal/-shm），保证一致性。输出备份目录。
backup_data() {
  local tag="$1" mp dir
  mp="$(volume_path)"
  [[ -n $mp ]] || return 0
  dir="backups/$(date +%Y%m%d-%H%M%S)-${tag:-none}"
  mkdir -p "$dir/data"
  chmod 700 backups "$dir"
  cp -a "$mp/." "$dir/data/"
  printf '%s\n' "$tag" >"$dir/tag"
  echo "$dir"
}

restore_data() {
  local src="$1" mp
  mp="$(volume_path)"
  [[ -n $mp && -d $src/data ]] || die "无法从 $src 恢复数据"
  find "$mp" -mindepth 1 -delete
  cp -a "$src/data/." "$mp/"
}

health_check() {
  local port
  port="$(sed -n 's/^RELAY_HOST_PORT=//p' .env | tail -1)"
  curl --fail --silent --show-error --max-time 5 "http://127.0.0.1:${port:-8080}/healthz" >/dev/null
}

start() { compose up -d --wait --wait-timeout "$WAIT_TIMEOUT" && health_check; }

prune() {
  local keep_tag="$1"
  # 镜像按创建时间倒序，保留最新 KEEP_IMAGES 个，正在使用的不删
  docker images "$IMAGE" --format '{{.Tag}}' | tail -n +"$((KEEP_IMAGES + 1))" | while read -r t; do
    [[ $t == "$keep_tag" ]] && continue
    docker rmi "$IMAGE:$t" >/dev/null 2>&1 && log "清理镜像 $IMAGE:$t" || true
  done
  # 只清理 relayctl 创建的备份（带 tag 文件），保留最新 KEEP_BACKUPS 个
  find backups -mindepth 2 -maxdepth 2 -name tag -printf '%h\n' 2>/dev/null | sort -r |
    tail -n +"$((KEEP_BACKUPS + 1))" | while read -r d; do
      rm -rf "$d" && log "清理备份 $d"
    done
}

cmd_deploy() {
  local tag="${1:?用法: relayctl deploy <tag>}" prev backup
  docker image inspect "$IMAGE:$tag" >/dev/null 2>&1 || die "镜像 $IMAGE:$tag 不存在，请先 docker load"
  prev="$(current_tag)"
  log "当前版本: ${prev:-无}，目标版本: $tag"

  docker inspect "$CONTAINER" >/dev/null 2>&1 && docker stop "$CONTAINER" >/dev/null
  backup="$(backup_data "$prev")"
  [[ -n $backup ]] && log "已备份数据到 $APP_DIR/$backup"

  set_tag "$tag"
  if start; then
    log "发布成功: $IMAGE:$tag"
    prune "$tag"
    return 0
  fi

  printf '\033[1;31m新版本启动失败，最近日志：\033[0m\n' >&2
  compose logs --tail=50 relay >&2 || true
  [[ -n $prev ]] || die "没有可恢复的旧版本"
  log "恢复到 $prev"
  compose stop relay >/dev/null 2>&1 || true
  [[ -n $backup ]] && restore_data "$backup"
  set_tag "$prev"
  start || die "恢复旧版本也失败了，请手工检查"
  die "发布失败，已恢复到 $prev（数据已还原）"
}

cmd_rollback() {
  local latest tag safety
  latest="$(find backups -mindepth 2 -maxdepth 2 -name tag -printf '%h\n' 2>/dev/null | sort -r | head -1)"
  [[ -n $latest ]] || die "没有可用的备份"
  tag="$(cat "$latest/tag")"
  [[ -n $tag && $tag != none ]] || die "$latest 没有记录镜像版本"
  docker image inspect "$IMAGE:$tag" >/dev/null 2>&1 || die "镜像 $IMAGE:$tag 已被清理"
  log "回滚到 $tag，数据还原为 $latest（此后写入的数据会丢失）"

  docker stop "$CONTAINER" >/dev/null
  safety="$(backup_data "$(current_tag)")"
  log "回滚前的数据另存为 $APP_DIR/$safety"
  restore_data "$latest"
  set_tag "$tag"
  start || die "回滚后启动失败，请手工检查"
  # 已消费的备份移走，避免下次 rollback 再回到同一点
  mv "$latest" "$latest.used"
  rm -f "$latest.used/tag"
  log "已回滚到 $IMAGE:$tag"
}

cmd_status() {
  compose ps
  echo
  docker inspect "$CONTAINER" --format 'image={{.Config.Image}} revision={{index .Config.Labels "org.opencontainers.image.revision"}} started={{.State.StartedAt}} health={{.State.Health.Status}}' 2>/dev/null || true
  echo
  echo "镜像："
  docker images "$IMAGE" --format '  {{.Tag}}\t{{.CreatedSince}}'
  echo "备份："
  find backups -mindepth 2 -maxdepth 2 -name tag -printf '  %h\n' 2>/dev/null | sort -r
}

case "${1:-}" in
  deploy) shift; cmd_deploy "$@" ;;
  rollback) cmd_rollback ;;
  status) cmd_status ;;
  logs) compose logs --tail="${2:-200}" relay ;;
  *) sed -n '2,8p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
